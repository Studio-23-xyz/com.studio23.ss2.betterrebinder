InputActionField {
    flex-direction: row;
    padding-bottom: 12px;
    justify-content: space-between;
    align-items: center;
    align-self: stretch;
    align-content: auto;
}

.input-action-field__binding-button {
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

